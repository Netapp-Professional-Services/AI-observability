                  "spec": {
                    "name": "A",
                    "query": "opensearch_indices_querycache_cache_size_number{cluster=\"$cluster\", node=~\"$node\"} or opensearch_indices_querycache_cache_size_bytes{cluster=\"$cluster\", node=~\"$node\"}",
                    "legend": "{{node}}"
                  }
                }
              }
            }
          ]
        }
      },
      "query-cache-evictions": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Query cache evictions"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
