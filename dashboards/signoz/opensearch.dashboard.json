              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "opensearch_indices_doc_number{cluster=\"$cluster\", node=~\"$node\"}",
                    "legend": "{{node}}"
                  }
                }
              }
            }
          ]
        }
      },
      "delete-rate": {
        "kind": "Panel",
        "spec": {
