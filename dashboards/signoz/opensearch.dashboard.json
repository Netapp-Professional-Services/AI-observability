{
  "schemaVersion": "v6",
  "generateName": true,
  "tags": [
    {
      "key": "component",
      "value": "opensearch"
    }
  ],
  "spec": {
    "display": {
      "name": "OpenSearch",
      "description": "Cluster, shards, thread pools, host, indexing, caches, and JVM charts for the OpenSearch Prometheus exporter (opensearch_*). Adapted from the OpenSearch mixin (Grafana dashboard 23029)."
    },
    "duration": "3h",
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "cluster",
          "display": {
            "name": "Cluster"
          },
          "allowMultiple": false,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "cluster",
              "signal": "metrics"
            }
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "node",
          "display": {
            "name": "Node"
          },
          "allowMultiple": true,
          "allowAllValue": true,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "node",
              "signal": "metrics"
            }
          }
        }
      }
    ],
    "panels": {
      "cluster-status": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Cluster status",
            "description": "0 = green, 1 = yellow, 2 = red."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "decimalPrecision": "0"
              },
              "thresholds": [
                {
                  "value": 0,
                  "color": "#22c55e",
                  "operator": "equal",
                  "format": "background"
                },
                {
                  "value": 1,
                  "color": "#eab308",
                  "operator": "equal",
                  "format": "background"
                },
                {
                  "value": 2,
                  "color": "#ef4444",
                  "operator": "equal",
                  "format": "background"
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "max(opensearch_cluster_status{cluster=\"$cluster\"})"
                  }
                }
              }
            }
          ]
        }
      },
      "cluster-health": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Cluster Health History",
            "description": "Green, yellow, and red cluster status over time."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": {
                  "GREEN": "#22c55e",
                  "YELLOW": "#eab308",
                  "RED": "#ef4444"
                }
              },
              "chartAppearance": {
                "lineStyle": "solid",
                "lineInterpolation": "linear",
                "fillMode": "solid",
                "showPoints": false
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "promql",
                        "spec": {
                          "name": "A",
                          "query": "(opensearch_cluster_status{cluster=\"$cluster\"} == 0) + 1",
                          "legend": "GREEN"
                        }
                      },
                      {
                        "type": "promql",
                        "spec": {
                          "name": "B",
                          "query": "(opensearch_cluster_status{cluster=\"$cluster\"} == 1)",
                          "legend": "YELLOW"
                        }
                      },
                      {
                        "type": "promql",
                        "spec": {
                          "name": "C",
                          "query": "(opensearch_cluster_status{cluster=\"$cluster\"} == 2) - 1",
                          "legend": "RED"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "cluster-nodes": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Nodes"
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "decimalPrecision": "0"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "max(opensearch_cluster_nodes_number{cluster=\"$cluster\"})"
                  }
                }
              }
            }
          ]
        }
      },
      "cluster-data-nodes": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Data nodes"
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "decimalPrecision": "0"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "max(opensearch_cluster_datanodes_number{cluster=\"$cluster\"})"
                  }
                }
              }
            }
          ]
        }
      },
      "cluster-pending-tasks": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Pending tasks"
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "decimalPrecision": "0"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "max(opensearch_cluster_pending_tasks_number{cluster=\"$cluster\"})"
                  }
                }
              }
            }
          ]
        }
      },
      "shards": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Shards",
            "description": "Shard counts by state."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "chartAppearance": {
                "lineStyle": "solid",
                "lineInterpolation": "linear",
                "fillMode": "none",
                "showPoints": false
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "max by (type) (opensearch_cluster_shards_number{cluster=\"$cluster\"})",
                    "legend": "{{type}}"
                  }
                }
              }
            }
          ]
        }
      },
      "threadpools": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Thread pool tasks",
            "description": "Tasks by thread pool."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "chartAppearance": {
                "lineStyle": "solid",
                "lineInterpolation": "linear",
                "fillMode": "none",
                "showPoints": false
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "max by (name) (opensearch_threadpool_tasks_number{cluster=\"$cluster\"})",
                    "legend": "{{name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "cpu": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "CPU usage"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "chartAppearance": {
                "lineStyle": "solid",
                "lineInterpolation": "linear",
                "fillMode": "none",
                "showPoints": false
              },
              "formatting": {
                "unit": "percent"
              },
              "axes": {
                "softMin": 0,
                "softMax": 100
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "opensearch_os_cpu_percent{cluster=\"$cluster\", node=~\"$node\"}",
                    "legend": "{{node}}"
                  }
                }
              }
            }
          ]
        }
      },
      "memory": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Memory usage"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "chartAppearance": {
                "lineStyle": "solid",
                "lineInterpolation": "linear",
                "fillMode": "none",
                "showPoints": false
              },
              "formatting": {
                "unit": "bytes"
              },
              "axes": {
                "softMin": 0
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "opensearch_os_mem_used_bytes{cluster=\"$cluster\", node=~\"$node\"}",
                    "legend": "{{node}}"
                  }
                }
              }
            }
          ]
        }
      },
      "disk": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Disk usage"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "chartAppearance": {
                "lineStyle": "solid",
                "lineInterpolation": "linear",
                "fillMode": "none",
                "showPoints": false
              },
              "formatting": {
                "unit": "percentunit"
              },
              "axes": {
                "softMin": 0,
                "softMax": 1
              },
              "thresholds": [
                {
                  "value": 0.8,
                  "color": "#eab308",
                  "label": "80%"
                },
                {
                  "value": 0.9,
                  "color": "#ef4444",
                  "label": "90%"
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "1 - opensearch_fs_path_available_bytes{cluster=\"$cluster\",node=~\"$node\"} / opensearch_fs_path_total_bytes{cluster=\"$cluster\",node=~\"$node\"}",
                    "legend": "{{node}} - {{path}}"
                  }
                }
              }
            }
          ]
        }
      },
      "index-rate": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Documents indexing rate"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "chartAppearance": {
                "lineStyle": "solid",
                "lineInterpolation": "linear",
                "fillMode": "none",
                "showPoints": false
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "rate(opensearch_indices_indexing_index_count{cluster=\"$cluster\", node=~\"$node\"}[5m])",
                    "legend": "{{node}}"
                  }
                }
              }
            }
          ]
        }
      },
      "index-latency": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Indexing latency"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "chartAppearance": {
                "lineStyle": "solid",
                "lineInterpolation": "linear",
                "fillMode": "none",
                "showPoints": false
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "rate(opensearch_indices_indexing_index_time_seconds{cluster=\"$cluster\", node=~\"$node\"}[5m]) / rate(opensearch_indices_indexing_index_count{cluster=\"$cluster\", node=~\"$node\"}[5m])",
                    "legend": "{{node}}"
                  }
                }
              }
            }
          ]
        }
      },
      "search-rate": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Search rate"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "chartAppearance": {
                "lineStyle": "solid",
                "lineInterpolation": "linear",
                "fillMode": "none",
                "showPoints": false
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "rate(opensearch_indices_search_query_count{cluster=\"$cluster\", node=~\"$node\"}[5m])",
                    "legend": "{{node}}"
                  }
                }
              }
            }
          ]
        }
      },
      "search-latency": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Search latency"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "chartAppearance": {
                "lineStyle": "solid",
                "lineInterpolation": "linear",
                "fillMode": "none",
                "showPoints": false
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "rate(opensearch_indices_search_query_time_seconds{cluster=\"$cluster\", node=~\"$node\"}[5m]) / rate(opensearch_indices_search_query_count{cluster=\"$cluster\", node=~\"$node\"}[5m])",
                    "legend": "{{node}}"
                  }
                }
              }
            }
          ]
        }
      },
      "doc-count": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Documents count (with replicas)"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "chartAppearance": {
                "lineStyle": "solid",
                "lineInterpolation": "linear",
                "fillMode": "solid",
                "showPoints": false
              }
            }
          },
          "queries": [
