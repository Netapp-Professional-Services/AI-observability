                  }
                }
              }
            }
          ]
        }
      },
      "query-cache-hits": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Query cache hits"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "chartAppearance": {
                "lineStyle": "solid",
                "lineInterpolation": "linear",
