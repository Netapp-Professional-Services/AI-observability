                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "rate(opensearch_indices_doc_deleted_number{cluster=\"$cluster\", node=~\"$node\"}[5m])",
                    "legend": "{{node}}"
                  }
                }
              }
            }
          ]
        }
      },
      "merge-rate": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Documents merging rate"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
