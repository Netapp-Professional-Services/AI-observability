                    "name": "A",
                    "query": "opensearch_indices_fielddata_memory_size_bytes{cluster=\"$cluster\", node=~\"$node\"}",
                    "legend": "{{node}}"
                  }
                }
              }
            }
          ]
        }
      },
      "fielddata-evictions": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Field data evictions"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
