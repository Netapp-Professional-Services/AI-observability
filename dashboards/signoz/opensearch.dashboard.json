                    "query": "rate(opensearch_indices_merges_total_docs_count{cluster=\"$cluster\",node=~\"$node\"}[5m])",
                    "legend": "{{node}}"
                  }
                }
              }
            }
          ]
        }
      },
      "fielddata-size": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Field data memory size"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "chartAppearance": {
