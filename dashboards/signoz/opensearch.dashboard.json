                    "legend": "{{node}}"
                  }
                }
              }
            }
          ]
        }
      },
      "query-cache-size": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Query cache size"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "chartAppearance": {
                "lineStyle": "solid",
                "lineInterpolation": "linear",
