# Copy to .env and fill in values. Do not commit .env.

# ---------------------------------------------------------------------------
# Backend mode (one or more local backends, or custom alone)
# ---------------------------------------------------------------------------
# ./scripts/start.sh openobserve              # self-hosted OpenObserve
# ./scripts/start.sh openlit                  # self-hosted OpenLIT
# ./scripts/start.sh victoriametrics          # self-hosted VictoriaMetrics (metrics)
# ./scripts/start.sh openobserve openlit      # fan out to both
# ./scripts/start.sh openobserve victoriametrics
# ./scripts/start.sh custom                   # any OTLP UI/store
#
# Collector config under collector/. scripts/start.sh sets this from the mode
# config.openobserve.yaml, config.openlit.yaml, config.victoriametrics.yaml,
# config.custom-grpc.yaml, or config.custom-http.yaml
# COLLECTOR_CONFIG=config.openobserve.yaml

# ---------------------------------------------------------------------------
# OpenObserve — profile openobserve
# ---------------------------------------------------------------------------
ZO_ROOT_USER_EMAIL=root@example.com
ZO_ROOT_USER_PASSWORD=Complexpass#123
# Optional host directory; leave unset for a named volume.
# OPENOBSERVE_DATA_DIR=

# Start script defaults these when unset.
# OPENOBSERVE_OTLP_ENDPOINT=openobserve:5081
# OPENOBSERVE_ORGANIZATION=default
# OPENOBSERVE_TLS_INSECURE=true
# OPENOBSERVE_AUTH_HEADER is built from ZO_ROOT_USER_* by the start script.

# ---------------------------------------------------------------------------
# OpenLIT — profile openlit
# UI: http://localhost:3000  (OTLP stays on the gateway :4317/:4318)
# Optional host directories; leave unset for named volumes
# (openlit-clickhouse-data and openlit-data).
# ---------------------------------------------------------------------------
# OPENLIT_UI_PORT=3000
# OPENLIT_CLICKHOUSE_DATA_DIR=../data/openlit/clickhouse
# OPENLIT_DATA_DIR=../data/openlit/openlit
# OPENLIT_OTLP_ENDPOINT=openlit:4317
# OPENLIT_DB_USER=default
# OPENLIT_DB_PASSWORD=OPENLIT
# OPENLIT_DB_NAME=openlit
# Optional OpenAI-compatible judge endpoint for Evaluations → Configuration.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: only needed when the endpoint uses a private or self-signed CA.
# PEM of public CAs plus that endpoint's issuing and root certs, not a leaf cert.
# OPENLIT_CA_BUNDLE=/Users/your-user/openlit-ca-bundle.pem

# ---------------------------------------------------------------------------
# VictoriaMetrics — profile victoriametrics (metrics only)
# UI: http://localhost:8428/vmui/
# Optional host directory; leave unset for named volume victoriametrics-data.
# ---------------------------------------------------------------------------
# VICTORIAMETRICS_UI_PORT=8428
# VICTORIAMETRICS_DATA_DIR=
# VICTORIAMETRICS_RETENTION=30d
# VICTORIAMETRICS_OTLP_METRICS_ENDPOINT=http://victoriametrics:8428/opentelemetry/v1/metrics
# VICTORIAMETRICS_TLS_INSECURE=true

# ---------------------------------------------------------------------------
# Custom OTLP backend — profile custom
# Point at any vendor UI that accepts OTLP (another OpenLIT, Grafana Alloy,
# Tempo, Jaeger, Honeycomb collector, etc.).
# ---------------------------------------------------------------------------
# CUSTOM_OTLP_ENDPOINT=http://my-backend:4317
# CUSTOM_OTLP_PROTOCOL=grpc
# For HTTP backends (e.g. OpenObserve-compatible):
# CUSTOM_OTLP_ENDPOINT=http://my-backend:5080/api/default
# CUSTOM_OTLP_PROTOCOL=http
# CUSTOM_OTLP_AUTH_HEADER=Basic REPLACE_WITH_TOKEN
# CUSTOM_OTLP_INSECURE=true
