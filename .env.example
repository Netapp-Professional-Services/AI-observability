# Copy to .env and fill in values. Do not commit .env.

# ---------------------------------------------------------------------------
# Backend mode (pick one when starting)
# ---------------------------------------------------------------------------
# ./scripts/start-with-docstream.sh openobserve         # self-hosted OpenObserve
# ./scripts/start-with-docstream.sh openobserve-cloud   # OpenObserve Cloud
# ./scripts/start-with-docstream.sh openlit             # self-hosted OpenLIT
# ./scripts/start-with-docstream.sh custom              # any OTLP UI/store
# Aliases: local → openobserve, cloud → openobserve-cloud

# ---------------------------------------------------------------------------
# OpenObserve — profile openobserve / openobserve-cloud
# ---------------------------------------------------------------------------
ZO_ROOT_USER_EMAIL=root@example.com
ZO_ROOT_USER_PASSWORD=Complexpass#123
# Optional host directory; leave unset for a named volume.
# OPENOBSERVE_DATA_DIR=

# Cloud (openobserve-cloud): from UI → Data sources → Custom → OTEL Collector.
# Endpoint = org base URL, no trailing slash, no /v1/traces suffix.
# OPENOBSERVE_OTLP_ENDPOINT=https://api.openobserve.ai/api/YOUR_ORG
# OPENOBSERVE_AUTH_HEADER=Basic REPLACE_WITH_BASE64_TOKEN

# Local (openobserve): start script defaults these when unset.
# OPENOBSERVE_OTLP_ENDPOINT=http://openobserve:5080/api/default
# OPENOBSERVE_AUTH_HEADER is built from ZO_ROOT_USER_* by the start script.

# ---------------------------------------------------------------------------
# OpenLIT — profile openlit
# UI: http://localhost:3000  (OTLP stays on the gateway :4317/:4318)
# ---------------------------------------------------------------------------
# OPENLIT_UI_PORT=3000
# OPENLIT_OTLP_ENDPOINT=openlit:4317
# OPENLIT_DB_USER=default
# OPENLIT_DB_PASSWORD=OPENLIT
# OPENLIT_DB_NAME=openlit

# ---------------------------------------------------------------------------
# Custom OTLP backend — profile custom
# Point at any vendor UI that accepts OTLP (another OpenLIT, Grafana Alloy,
# Tempo, Jaeger, Honeycomb collector, etc.).
# ---------------------------------------------------------------------------
# CUSTOM_OTLP_ENDPOINT=http://my-backend:4317
# CUSTOM_OTLP_PROTOCOL=grpc
# For HTTP backends (e.g. OpenObserve-compatible):
# CUSTOM_OTLP_ENDPOINT=http://my-backend:5080/api/default
# CUSTOM_OTLP_PROTOCOL=http
# CUSTOM_OTLP_AUTH_HEADER=Basic REPLACE_WITH_TOKEN
# CUSTOM_OTLP_INSECURE=true

# ---------------------------------------------------------------------------
# DocStream join
# ---------------------------------------------------------------------------
# Path to the DocStream checkout (sibling by default).
DOCSTREAM_DIR=../docstream
# Shared Compose project so DocStream and this gateway share one network.
COMPOSE_PROJECT_NAME=docstream

# In DocStream .env (required for the new otel-collector-agent):
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Optional logs upstream (defaults to the same endpoint when unset):
#   OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://otel-collector:4317
