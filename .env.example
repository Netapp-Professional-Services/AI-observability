# Copy to .env and fill in values. Do not commit .env.

# ---------------------------------------------------------------------------
# Backend mode
# ---------------------------------------------------------------------------
# cloud  — otel-collector only; exports to OpenObserve Cloud free tier
# local  — self-hosted OpenObserve + collector on the same compose network
# Start with: podman compose --profile cloud up -d
#          or: podman compose --profile local up -d

# ---------------------------------------------------------------------------
# OpenObserve Cloud (profile: cloud)
# From Cloud UI → Data sources → Custom → OTEL Collector
# Endpoint must be base URL with org, NO trailing slash, NO /v1/traces suffix.
# ---------------------------------------------------------------------------
# OPENOBSERVE_OTLP_ENDPOINT=https://api.openobserve.ai/api/YOUR_ORG
# Authorization value is "Basic <base64(email:ingestion_token)>" — paste the
# full header value from the UI, or encode: printf '%s' 'email:token' | base64
# OPENOBSERVE_AUTH_HEADER=Basic REPLACE_WITH_BASE64_TOKEN

# ---------------------------------------------------------------------------
# Self-hosted OpenObserve (profile: local)
# UI: http://localhost:5080
# ---------------------------------------------------------------------------
ZO_ROOT_USER_EMAIL=root@example.com
ZO_ROOT_USER_PASSWORD=Complexpass#123
# Optional host directory; leave unset for a named volume.
# OPENOBSERVE_DATA_DIR=

# When using profile local, the collector defaults to the in-compose OpenObserve.
# Override only if you point the collector elsewhere.
# OPENOBSERVE_OTLP_ENDPOINT=http://openobserve:5080/api/default
# OPENOBSERVE_AUTH_HEADER is built from ZO_ROOT_USER_* when using scripts/start-with-docstream.sh
# For manual local runs, set:
# OPENOBSERVE_AUTH_HEADER=Basic $(printf '%s' 'root@example.com:Complexpass#123' | base64)

# ---------------------------------------------------------------------------
# DocStream join
# ---------------------------------------------------------------------------
# Absolute or relative path to the DocStream checkout (sibling by default).
DOCSTREAM_DIR=../docstream
# Compose project name shared with DocStream so services share one network.
COMPOSE_PROJECT_NAME=docstream
